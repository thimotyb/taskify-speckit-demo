# Copy to .env and fill in real values. Never commit .env.
# Shared secret for service-to-service calls (at least 32 random characters).
TASKIFY_SERVICE_TOKEN=
# H2 database credentials and file-encryption key (used by the compose profile).
TASKIFY_DB_USER=
TASKIFY_DB_PASSWORD=
TASKIFY_DB_FILE_KEY=
# Directory for local (non-Docker) H2 database files.
TASKIFY_DATA_DIR=
